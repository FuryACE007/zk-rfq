# Essential Protocol
ESSENTIAL_URL=http://localhost:3553

# Sepolia EVM (public settlement layer)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
GATEWAY_PRIVATE_KEY=0x...your_deployer_private_key...

# Contract addresses (output of `forge script script/Deploy.s.sol`)
SETTLEMENT_CONTRACT=0x...
MOCK_WETH_ADDRESS=0x...
MOCK_USDC_ADDRESS=0x...
AGGREGATE_VERIFIER_ADDRESS=0x...
LIMIT_VERIFIER_ADDRESS=0x...

# Uniswap V3 pool (output of `forge script script/SetupPool.s.sol`)
UNISWAP_POOL_ADDRESS=0x...
QUOTER_V2_ADDRESS=0xEd1f6473345F45b75F8179591dd5bA1888cf2FB3

# Path to Noir circuits directory (for server-side limit_check proof generation)
# Default: ../../circuits (relative to gateway dir, pointing to repo root circuits/)
CIRCUITS_PATH=../../circuits
